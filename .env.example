APP_NAME=careerbridge
ENVIRONMENT=development
DEBUG=false
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:8000
POSTGRES_DB=careerbridge
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-with-a-local-db-password
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg2://postgres:replace-with-a-local-db-password@localhost:5432/careerbridge
SECRET_KEY=replace-with-a-local-development-secret
JWT_SECRET_KEY=replace-with-a-different-local-development-secret
JWT_REFRESH_SECRET=replace-with-another-local-development-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
CORS_ORIGINS=http://localhost:5173
